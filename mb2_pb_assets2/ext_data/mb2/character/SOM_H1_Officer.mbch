ClassInfo
{
	name 				"SOM_H1_Officer"
	weapons 			WP_MELEE|WP_BLASTER|WP_BLASTER_PISTOL|WP_FRAG_NADE|WP_SONIC_NADE
	attributes		MB_ATT_RALLY,1|MB_ATT_FRAGS,1|MB_ATT_PISTOL,3|MB_ATT_HEALING,2|MB_ATT_DODGE,2|MB_ATT_ASSEMBLE,1|MB_ATT_AMMO,3|MB_ATT_BLASTER,3|MB_ATT_SONIC_DETONATOR,2|MB_ATT_DRONE|MB_ATT_BINOCULARS
	//holdables			HI_SEEKER|HI_BINOCULARS
	maxhealth			90
	maxarmor			50
	extralives			2
	
	model				"gwethenea"
	skin				"rebel"
	uishader			"models/players/gwethenea/mb2_icon_rebel"

	model_1				"rebel_guerilla"
	skin_1				"sullustan"
	uishader_1			"models/players/rebel_guerilla/mb2_icon_sullustan"				
	
	model_2				"nrguard" 				
	skin_2				"default"					
	uishader_2			"models/players/nrguard/mb2_icon_default"

	model_3				"rebel" 				
	skin_3				"desert"					
	uishader_3			"models/players/rebel/mb2_icon_desert"
	
