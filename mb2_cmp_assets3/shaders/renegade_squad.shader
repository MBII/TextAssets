models/players/renegade_wookie/armor
{
    {
        map models/players/renegade_wookie/armor
        blendFunc GL_ONE GL_ZERO
        rgbGen lightingDiffuse
    }
    {
        map models/players/renegade_wookie/armor_spec
        blendFunc GL_SRC_ALPHA GL_ONE
        alphaGen lightingSpecular
    }
}

