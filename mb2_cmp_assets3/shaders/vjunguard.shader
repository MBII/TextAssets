models/players/vjunguard/metal
{
    {
        map models/players/vjunguard/metal
        blendFunc GL_ONE GL_ZERO
        rgbGen lightingDiffuse
    }
    {
        map models/players/vjunguard/spec
        blendFunc GL_SRC_ALPHA GL_ONE
        alphaGen lightingSpecular
    }
}

models/players/vjunguard/red
{
    {
        map models/players/vjunguard/red
        glow
        rgbGen identity
    }
}

models/players/vjunguard/blue
{
    {
        map models/players/vjunguard/blue
        glow
        rgbGen identity
    }
}