// blue
models/players/sithtrooper/hips_blue
{
	{
		map models/players/sithtrooper/hips_blue
		rmoMap models/players/sithtrooper/hips_RMO
		blendFunc GL_ONE GL_ZERO
		rgbGen lightingDiffuse
	}
}

