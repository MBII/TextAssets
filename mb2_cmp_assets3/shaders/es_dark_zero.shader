models/players/es_dark_zero/arms
{
	cull	twosided
    {
        map models/players/es_dark_zero/arms
        blendFunc GL_ONE GL_ZERO
        rgbGen lightingDiffuse
    }
    {
        map models/players/es_dark_zero/arms_spec
        blendFunc GL_SRC_ALPHA GL_ONE
        detail
        alphaGen lightingSpecular
    }
}

