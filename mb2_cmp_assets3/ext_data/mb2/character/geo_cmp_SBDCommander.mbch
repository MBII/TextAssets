//Siege class def file.

ClassInfo
{
	name				"geo_cmp_SBDCommander"
	weapons				WP_MELEE|WP_BLASTER_PISTOL|WP_DLT20A|WP_REAL_TD
	WP_MeleeFlags		HELD_SLOW
	attributes			MB_ATT_PISTOL,2|MB_ATT_DLT20A,3|MB_ATT_THERMALS,1|MB_ATT_AMMO,3|MB_ATT_DODGE,2|MB_ATT_HEALING,2|MB_ATT_RALLY,1|MB_ATT_RECHARGE,3|MB_ATT_CCTRAINING,1|MB_ATT_GETUPS,2
	maxhealth			100
	maxarmor			60
	basespeed			250
	speed				0.89
	model				"battledroid"
	skin				"geonosis_comm"
	uishader			"models/players/battledroid/mb2_icon_geonosis_comm"
	MBClass				MB_CLASS_BATTLEDROID
	classNumberLimit	1
	
	special1			EAS_HI_DODGE
	special3			EAS_HI_KICK
