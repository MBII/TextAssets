//Siege class def file.

ClassInfo
{
	name			"bast_ren_fur"
	weapons			WP_MELEE|WP_BLASTER_PISTOL|WP_CLONE_RIFLE
        attributes	        MB_ATT_AMMO,3|MB_ATT_CLONERIFLE,2|MB_ATT_PISTOL,1|MB_ATT_WOOKIE_STRENGTH,3|MB_ATT_WOOKIEE_FURY,3
        resource                RESOURCE_FORCE
        forcepool               100
	maxhealth		300
        maxarmor                300
        WP_CloneRifleFlags      HELD_ALTRELOAD
	model			"renegade_wookie" 				//this is optional, if it's here it forces the model to this.
	skin			"default"					//this is optional, if it's here it forces the skin to this.
        uishader	        "models/players/renegade_wookie/mb2_icon_default"
	MBClass			MB_CLASS_WOOKIE
        modelscale              1.20
	classNumberLimit	1
        gloatAnim               BOTH_TUSKENTAUNT1
        flourishAnim            BOTH_TURNSTAND1
}

WeaponInfo0
{
	WeaponToReplace		WP_CLONE_RIFLE					//Required: Weapon Slot of weapon you're replacing
	WeaponBasedOff		WP_CLONE_RIFLE					//Required: For future use, should be the same as WeaponToReplace
	NewWorldModel		"models/weapons2/dlt-18_repeater/dlt-18_repeater_w.glm"  	//Required: New 3rd person/dropped weapon model
	NewViewModel		"models/weapons2/dlt-18_repeater/dlt-18_repeater.md3" 	  	//Required: New 1st person weapon model
	Icon			"gfx/hud/w_icon_dlt-18" 	//Required: Weapon change icon
	WeaponName		"DLT-18 Rifle"    					//Required: Weapon change display name
        altFireEnabled          0
        FlashSound0             "sound/weapons/eweb/eweb_fire.mp3"
        MuzzleEffect		"blaster/Muzzle_Flash"
	AltMuzzleEffect		"blaster/Muzzle_Flash"
	MissileEffect		"blaster/shot"
	AltMissileEffect	"blaster/shot"
	MissileMissEffect "blaster/wall_impact"
	altMissileMissEffect "blaster/wall_impact" 
}

description	"Renegade Squadron: Wookie

Weaponry:
Pistol
DLT-18 Rifle 

Attributes:
Strength 3
Fury 3
Fast Fury Regen

The Renegade Squadron was a Rebel Alliance military unit of pirates, smugglers, and other types of fringers assembled and commanded by Col Serra at Han Solo's request. The unit consisted of underworlders recruited by Serra from around the galaxy."


