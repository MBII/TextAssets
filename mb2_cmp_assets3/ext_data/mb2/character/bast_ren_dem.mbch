//Siege class def file.

ClassInfo
{
	name			"bast_ren_dem"
	weapons			WP_MELEE|WP_BLASTER_PISTOL|WP_UGL|WP_FIRE_NADE|WP_PULSE_NADE|WP_FRAG_NADE|WP_REAL_TD|WP_CONC_NADE
        attributes	        MB_ATT_AMMO,3|MB_ATT_PISTOL,3|MB_ATT_FIRE_GRENADES,5|MB_ATT_PULSE_GRENADES,5|MB_ATT_FRAGS,5|MB_ATT_THERMALS,1|MB_ATT_DASH,1|MB_ATT_KNOCKDOWN_ROLL,1|MB_ATT_MICRO_GRENADES,10|MB_ATT_UGL,3|MB_ATT_EWEB,1
	maxhealth		120
        maxarmor                120
        baseSpeed               200

        WP_UGLFlags             HELD_LOWDAMAGE
        WP_RealTDFlags          HELD_LOWDAMAGE
        WP_FragNadeFlags        HELD_LOWDAMAGE
        WP_PulseNadeFlags       HELD_LOWDAMAGE
        WP_FireNadeFlags        HELD_LOWDAMAGE
        WP_ConcNadeFlags        HELD_LOWDAMAGE

	model			"renegade_male1" 				//this is optional, if it's here it forces the model to this.
	skin			"default"					//this is optional, if it's here it forces the skin to this.
        uishader	        "models/players/renegade_male1/mb2_icon_default"

