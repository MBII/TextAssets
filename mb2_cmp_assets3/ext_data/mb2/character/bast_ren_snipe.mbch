//Siege class def file.

ClassInfo
{
	name			"bast_ren_snipe"
	weapons			WP_MELEE|WP_BLASTER_PISTOL|WP_AMBAN
        attributes	        MB_ATT_AMMO,3|MB_ATT_AMBAN,3|MB_ATT_PISTOL,3|MB_ATT_DODGE,1|MB_ATT_DASH,1|MB_ATT_POISON_DART,3|MB_ATT_CLOAK,1|MB_ATT_SHOCKFIELD,1
	maxhealth		120
        forcepool               120
        forcepowers             FP_SEE,3
        maxarmor                100
        classflags              CFL_SEEING_STEALTH
        special2                EAS_HI_DASH
        special1                EAS_HI_DODGE
        special3                EAS_HI_POISON
        special4                EAS_HI_SHOCKFIELD
        resource                RESOURCE_FORCE
	model			"renegade_male3" 				//this is optional, if it's here it forces the model to this.
	skin			"default"					//this is optional, if it's here it forces the skin to this.
        uishader	        "models/players/renegade_male3/mb2_icon_default"
        model_1                 "renegade_male3"
        skin_1                  "alt"
        uishader_1	        "models/players/renegade_male3/mb2_icon_alt"
	MBClass			MB_CLASS_BOUNTY_HUNTER
	classNumberLimit	1
        meditateAnim            BOTH_CROUCH3
        flourishAnim            BOTH_STAND1_TALK3
}

WeaponInfo0
{
	WeaponToReplace		WP_AMBAN					//Required: Weapon Slot of weapon you're replacing
	WeaponBasedOff		WP_AMBAN					//Required: For future use, should be the same as WeaponToReplace
	NewWorldModel		"models/weapons2/DLT20a/dlt20a_w.glm"  	//Required: New 3rd person/dropped weapon model
	NewViewModel		"models/weapons2/DLT20a/dlt20a.md3" 	  	//Required: New 1st person weapon model
	Icon			"gfx/hud/w_icon_DLT20a" 	//Required: Weapon change icon
	WeaponName		"DLT20 Modified"    					//Required: Weapon change display name
        altFireEnabled          1
        primFireEnabled         0
        FlashSound0             "sound/weapons/noghri/fire.mp3"
        altFlashSound0          "sound/weapons/noghri/fire.mp3"
        MuzzleEffect		"blaster/Muzzle_Flash"
	AltMuzzleEffect		"blaster/Muzzle_Flash"
	MissileEffect		"blaster/shot"
	AltMissileEffect	"blaster/shot"
	MissileMissEffect "blaster/wall_impact"
	altMissileMissEffect "blaster/wall_impact" 
        customAmmo              80
}

WeaponInfo1
{
	WeaponToReplace		WP_BLASTER_PISTOL					//Required: Weapon Slot of weapon you're replacing
	WeaponBasedOff		WP_BLASTER_PISTOL					//Required: For future use, should be the same as WeaponToReplace
