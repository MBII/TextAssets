//Siege class def file.

ClassInfo
{
	name				"um_sniper_trooper"
	weapons				WP_MELEE|WP_BLASTER_PISTOL|WP_T21|WP_PULSE_NADE|WP_PLX1
	attributes			MB_ATT_PLX1,1|MB_ATT_PULSE_GRENADES,2|MB_ATT_PISTOL,2|MB_ATT_T21,3|MB_ATT_AMMO,2|MB_ATT_DODGE,1
	maxhealth			100
	maxarmor			45
	extraLives			2
	model				"stormie"
	skin				"default"
	uishader			"models/players/stormie/mb2_icon_default"
