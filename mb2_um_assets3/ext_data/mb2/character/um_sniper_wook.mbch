	name				"um_sniper_wook"
	weapons				WP_BLASTER_PISTOL|WP_BOWCASTER|WP_MELEE|WP_PLX1|WP_PULSE_NADE
	attributes			MB_ATT_PULSE_GRENADES,2|MB_ATT_PLX1,2|MB_ATT_BOWCASTER,3|MB_ATT_AMMO,3|MB_ATT_PISTOL,2|MB_ATT_WOOKIE_STRENGTH,3
	maxhealth			350
