{
	AutoMap0
	{
		radargraphic "gfx/automap/um_ptf_dreamtime"
		radargraphicfull "gfx/automap/um_ptf_dreamtimefull"
		height "0"
	}
}

roundbegin_target ""

Mom
{
	RequiredObjectives 1
	Timed 720
	UseTeam "dreamtime_mom"
	TeamIcon "gfx/2d/logos/mb_rebel"
	TeamColorOn	"1 0 0 1"
	TeamColorOff ".7 0 0 1"

	Objective1
	{
		goalname "Carry Grogu to your base"
		final 0
		message_team1 ""
		message_team2 ""
		objdesc "Carry Grogu to your base"
		objgfx "gfx/mp/mplevels/mb2_ctf_deathstar/obj1r"
	}

	wonround "Grogu is fast asleep!"
	lostround "They've captured Grogu..."
	roundover_sound_wewon ""
	roundover_sound_welost ""
	roundover_target "siegeend"
	attackers 1
	briefing "Capture the flag."
}

