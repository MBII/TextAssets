jumpAtkRightMove LS_NONE
lungeAtkMove LS_KICK_F
g2MarksShader "gfx/damage/bloodcutmark"
g2WeaponMarkShader "gfx/effects/bloodsplat"
spinsound	"s/w/t/swing3.wav"
swingSound1	"s/w/h/swing1.mp3"
swingSound2	"s/w/h/swing2.mp3"
swingSound3	"s/w/h/swing3.mp3"
spinSound	"s/w/m/swing1.mp3"
swingSound1	"s/w/m/swing2.mp3"
swingSound2	"s/w/m/swing3.mp3"
swingSound3	"s/w/m/swing4.mp3"
bounceSound1	"s/w/m/swing4.mp3"	
bounceSound2	"s/w/m/swing2.mp3"
bounceSound3	"s/w/m/swing1.mp3"
hitSound1	"sound/weapons/baton/fire.mp3"
hitSound2	"sound/weapons/baton/fire.mp3"
hitSound3	"sound/weapons/baton/fire.mp3"
blockSound1	"s/w/h/block1.mp3"
blockSound2	"s/w/h/block2.mp3"
blockSound3	"s/w/h/block3.mp3"
