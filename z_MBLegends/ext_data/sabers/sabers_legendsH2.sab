//Starkiller
saber_marek_legends
{
	name  		"Starkiller - Double (TFU II)"
	saberType 	SABER_SINGLE
	saberModel  "models/weapons2/saber_plasma/saber_marek2.glm"
	soundOn		"sound/weapons/saber/saberon_v5.mp3"
	soundLoop	"sound/weapons/saber/saberhum_galen2.wav"
	soundOff	"sound/weapons/saber/saberoff_v4.mp3"
	saberLength 	40
	saberColor  	blue
 damageScale 1
	jumpAtkFwdMove 	LS_DUAL_SPIN_PROTECT
	lungeAtkMove LS_SPINATTACK_DUAL
 jumpAtkLeftMove LS_STABDOWN_DUAL
 jumpAtkRightMove LS_STABDOWN_DUAL
	spinsound	"sound/weapons/saber/OT/saberspin.wav"
	hitSound1	"sound/weapons/saber/OT/saberhit1.mp3"
 hitSound2	"sound/weapons/saber/OT/saberhit2.mp3"
 hitSound3	"sound/weapons/saber/OT/saberhit3.mp3"
	drawAnim BOTH_A6_LR
 knockbackScale 0.25
}
