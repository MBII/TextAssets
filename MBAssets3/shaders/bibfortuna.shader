models/players/bibfortuna/head
{
	q3map_nolightmap
    {
        map models/players/bibfortuna/head
        alphaFunc GE128
        blendFunc GL_ONE GL_ZERO
        depthWrite
        rgbGen lightingDiffuse
    }
    {
        map models/players/bibfortuna/head_spec
        blendFunc GL_SRC_ALPHA GL_ONE
        detail
        alphaGen lightingSpecular
    }
}

