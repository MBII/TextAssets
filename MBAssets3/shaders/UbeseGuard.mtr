models/players/UbeseGuard/cloth
{
	cull	twosided
	{
		map models/players/UbeseGuard/cloth_D
		normalMap models/players/UbeseGuard/cloth_N
		rmoMap models/players/UbeseGuard/cloth_rmo
		rgbGen lightingDiffuse
	}
}

models/players/UbeseGuard/coat
{
	cull	twosided
	{
		map models/players/UbeseGuard/coat_D
		normalMap models/players/UbeseGuard/coat_N
		rmoMap models/players/UbeseGuard/coat_rmo
		rgbGen lightingDiffuse
	}
	{
		map models/players/UbeseGuard/emission
		blendfunc gl_one gl_one
		glow
		rgbGen wave sin 0 1 0 0.5
	}
}

models/players/UbeseGuard/mask
{
	{
		map models/players/UbeseGuard/mask_D
		normalMap models/players/UbeseGuard/mask_N
		rmoMap models/players/UbeseGuard/mask_rmo
		rgbGen lightingDiffuse
	}
}