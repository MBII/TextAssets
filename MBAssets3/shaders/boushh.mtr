models/players/boushh/face
{
	cull twosided
	{
		map models/players/boushh/face
		rgbGen lightingDiffuse
	}
 	{
        map models/players/boushh/face_s
       	blendFunc GL_SRC_ALPHA GL_ONE
      	detail
       	alphaGen lightingSpecular
	}
}