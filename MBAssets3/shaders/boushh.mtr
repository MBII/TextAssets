models/players/boushh/Ubesebod
{
	cull twosided
	{
		map models/players/boushh/Ubesebod_A
		normalMap models/players/boushh/Ubesebod_N
		rmoMap models/players/boushh/Ubesebod_RMO
		rgbGen lightingDiffuse
	}
}

