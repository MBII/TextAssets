models/players/darthsion/belt_flaps
{
	cull twosided
	{
		map models/players/darthsion/belt_flaps
		rgbGen lightingDiffuse
	}
	{
		map models/players/darthsion/belt_flaps_spec
		blendFunc GL_SRC_ALPHA GL_ONE
		alphaGen lightingSpecular
		detail
	}
}

