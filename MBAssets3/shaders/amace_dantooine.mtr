textures/amace_dantooine/Grass01
{
 	q3map_shadeangle 120
	q3map_material ShortGrass
	{
		map $lightmap
	}	
	{
		map textures/amace_dantooine/Grass01_A
		normalHeightMap textures/amace_dantooine/Grass01_NH
		rmoMap textures/amace_dantooine/Grass01_RMO
		blendFunc GL_DST_COLOR GL_ZERO
	}
    {
		map textures/amace_dantooine/GrassBlades01
			surfaceSprites vertical 40 15 60 400
			ssFademax 2000
			ssFadescale 1
			ssVariance 1 2
			ssWind 0.5
		alphaFunc GE192
		blendFunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
		depthWrite
    }
    {
		map textures/amace_dantooine/GrassBlades02
			surfaceSprites vertical 50 15 30 500
			ssFademax 2000
			ssFadescale 1
			ssVariance 1 2
			ssWind 0.5
		alphaFunc GE192
		blendFunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
		depthWrite
    }
    {
		map textures/amace_dantooine/GrassBlades03
			surfaceSprites vertical 50 30 120 500
			ssFademax 2000
			ssFadescale 1
			ssVariance 1 2
			ssWind 0.5
		alphaFunc GE192
		blendFunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
		depthWrite
    }
    {
		map textures/amace_dantooine/GrassBlades04
			surfaceSprites vertical 45 27 90 400
			ssFademax 2000
			ssFadescale 1
			ssVariance 1 2
			ssWind 0.5
		alphaFunc GE192
		blendFunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
		depthWrite
    }
    {
		map textures/amace_dantooine/GrassBlades05
			surfaceSprites vertical 35 20 55 500
			ssFademax 2000
			ssFadescale 1
			ssVariance 1 2
			ssWind 0.5
		alphaFunc GE192
		blendFunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
		depthWrite
    }
}

