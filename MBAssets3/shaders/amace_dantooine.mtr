textures/amace_dantooine/GardenWater
{
	qer_editorimage	textures/amace_dantooine/water
	qer_trans	0.8
	surfaceparm	nonsolid
	surfaceparm	water
	surfaceparm	trans
	q3map_material	Water
	{
		map textures/amace_dantooine/water
		blendFunc GL_ONE GL_SRC_ALPHA
		rgbGen const ( 0.4 0.4 0.4 )
		alphaFunc GE128
		alphaGen const 1.0
	}
	{
		map $lightmap
		blendFunc GL_DST_COLOR GL_ZERO
	}
}

