models/map_objects/khorne_dant/large_crystal_r
{
	qer_editorimage	models/map_objects/khorne_dant_gtk/large_crystal_r
	surfaceparm			trans
    {
        map $lightmap
    }
    {
        map map models/map_objects/khorne_dant/large_crystal_a
		normalMap models/map_objects/khorne_dant/large_crystal_nh
		rmoMap models/map_objects/khorne_dant/large_crystal_rmo
        blendFunc GL_DST_COLOR GL_ZERO
    }
    {
        map models/map_objects/khorne_dant/large_crystal_a
        blendFunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
        rgbGen const ( 1.000000 0.000000 0.000000 )
    }
    {
        map models/map_objects/khorne_dant/large_crystal_glow
        blendFunc GL_ONE GL_DST_ALPHA
        glow
        detail
        rgbGen const ( 1.000000 0.200000 0.000000 )
        alphaGen wave sin 0.9 0.1 0.1 0.5
    }
}

