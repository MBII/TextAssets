        blendFunc GL_DST_COLOR GL_ZERO
    }
    {
        map models/map_objects/khorne_dant/pond_crystal_small_a
        blendFunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
        rgbGen const ( 1.000000 0.200000 0.000000 )
    }
    {
        map models/map_objects/khorne_dant/pond_crystal_small_glow
        blendFunc GL_ONE GL_ONE
        rgbGen const ( 1.000000 1.000000 0.000000 )
        alphaGen wave sin 0.9 0.1 0.1 0.5
    }
    {
        map models/map_objects/khorne_dant/pond_crystal_small_glow
        blendFunc GL_ONE GL_ONE
        glow
        detail
        rgbGen const ( 1.000000 0.400000 0.000000 )
        alphaGen wave sin 0.9 0.1 0.1 0.5
    }
}

