models/players/savage_opress/head
{
	{
		map models/players/savage_opress/head
		blendFunc GL_ONE GL_ZERO
		rgbGen lightingDiffuse
	}
	{
		map models/players/savage_opress/head_s
		blendFunc GL_SRC_ALPHA GL_ONE
		alphaGen lightingSpecular
