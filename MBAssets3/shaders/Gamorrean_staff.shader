models/weapons2/thok/baton_new
{
	cull twosided
    {
        map models/weapons2/thok/baton_new
        rgbGen lightingDiffuse
    }
    {
        map models/weapons2/thok/baton_new
        blendFunc GL_SRC_ALPHA GL_ONE
        detail
        alphaGen lightingSpecular
    }
}

