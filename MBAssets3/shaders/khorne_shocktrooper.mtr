models/players/shocktrooper/arms
{
	{
		map models/players/shocktrooper/arms_a
		normalMap models/players/shocktrooper/arms_nh
		rmoMap models/players/shocktrooper/arms_rmo
		rgbGen lightingDiffuse
		blendFunc GL_ONE GL_ZERO
		//parallaxDepth 0 parallaxBias 0.5
	}
}


