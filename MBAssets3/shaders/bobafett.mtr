models/players/bobafett/rotj
{
	{
		map models/players/bobafett/rotj_A
		normalMap models/players/bobafett/rotj_N
		rmoMap models/players/bobafett/rotj_RMO
		rgbGen lightingDiffuse
		blendFunc GL_ONE GL_ZERO
	}
	{
		map models/players/bobafett/glow
		blendfunc gl_one gl_one
		glow
		rgbGen wave sin 0 1 0 0.5
	}
}

models/players/bobafett/rotj_armor
{
	cull twosided
	{
		map models/players/bobafett/rotj_A
		normalMap models/players/bobafett/rotj_N
		rmoMap models/players/bobafett/rotj_RMO
		rgbGen lightingDiffuse
		blendFunc GL_ONE GL_ZERO
	}
	{
		map models/players/bobafett/glow
		blendfunc GL_ONE GL_ONE
		glow
		rgbGen wave sin 0 1 0 0.5
	}
}
	
