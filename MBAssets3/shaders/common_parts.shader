models/players/common/lashes
{
	q3map_nolightmap
	cull	disable
	{
		map models/players/common/lashes
		alphaFunc GE192
                                blendFunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
		depthWrite
		rgbGen lightingDiffuse
	}
}

