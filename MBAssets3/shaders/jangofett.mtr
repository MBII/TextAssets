models/players/jangofett/jango
{
	{
		map models/players/jangofett/jango_A
		normalMap models/players/jangofett/jango_N
		rmoMap models/players/jangofett/jango_RMO
		rgbGen lightingDiffuse
		blendFunc GL_ONE GL_ZERO
	}
}

models/players/jangofett/jango_armor
