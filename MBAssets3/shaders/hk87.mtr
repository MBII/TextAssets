models/players/hk87/HK_torso
{
	{
		map models/players/hk87/HK_torso_D
		normalMap models/players/hk87/HK_torso_N
		rmoMap models/players/hk87/HK_torso_rmo
		rgbGen lightingDiffuse
	}
}

models/players/hk87/HK_torso_rope
{
	cull twosided
	{
		map models/players/hk87/HK_torso_D
		normalMap models/players/hk87/HK_torso_N
		rmoMap models/players/hk87/HK_torso_rmo
		rgbGen lightingDiffuse
	}
}


