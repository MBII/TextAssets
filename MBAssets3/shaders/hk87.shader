 models/players/hk87/HK_torso
	{
	{
		map models/players/hk87/HK_torso
		rgbGen lightingDiffuse
	}
 	{
        		map models/players/hk87/HK_torso_s
       		 blendFunc GL_SRC_ALPHA GL_ONE
      		  detail
       		 alphaGen lightingSpecular
	}
	}

