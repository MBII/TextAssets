models/players/deathwatch/extras
{
	cull twosided
	{
		map models/players/deathwatch/extras
		normalMap models/players/deathwatch/extras_N
		rmoMap models/players/deathwatch/extras_RMO
		rgbGen lightingDiffuse
	}
	{
		map models/players/deathwatch/extras_e
       	blendFunc GL_ONE GL_ONE
      	glow
	}
}

models/players/deathwatch/deathwatch
{
	{
		map models/players/deathwatch/deathwatch
		normalMap models/players/deathwatch/mando_N
		rmoMap models/players/deathwatch/mando_RMO
		rgbGen lightingDiffuse
	}
}

