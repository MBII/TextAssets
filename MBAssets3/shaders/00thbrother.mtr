models/players/00thbrother/cape
{
	cull	twosided
	{
		map models/players/00thbrother/cape
		rgbGen lightingDiffuse
	}
	{
		map models/players/00thbrother/cape_spec
		blendFunc GL_SRC_ALPHA GL_ONE
		detail
		alphaGen lightingSpecular
	}
}

