models/players/00thbrother/bholehelm
{
	cull	twosided
	{
		map models/players/00thbrother/bholehelm_A
		normalMap models/players/00thbrother/bholehelm_N
		rmoMap models/players/00thbrother/bholehelm_RMO
		rgbGen lightingDiffuse
	}
}

