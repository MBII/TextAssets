	forceRegenAmount	0.95
	Pbchance 40
	MBchance 4
	SBchance 90
	saberStyle	3
	saberStyle	4
	FP_LEVITATION	3
	FP_SPEED		3
	FP_PUSH			3
	FP_PULL			2
	FP_GRIP			3
	FP_SEE			2
	FP_SABERTHROW	3
	rank		captain
	reactions	5
	aim			5
	move		3
	aggression	5
	evasion		2
	intelligence	5
	hfov		130
	vfov		130
	scale		109
	height		78
	crouchheight 42
	width		18
	playerTeam	TEAM_PLAYER
	enemyTeam	TEAM_ENEMY
//	race		human
	class		CLASS_DESANN
	yawSpeed	120
	walkSpeed	155
	runSpeed	205
	snd			darthvader
	sndcombat	darthvader
	sndjedi		darthvader
	health		75
	armor		70
}

