//NNN: Basic Sith each setup with a different force power and a saber for testing purposes
//NNN: These are meant for testing, not use on maps!
saber_lightning
{
	playerModel	reborn_concept
	customSkin	force
	MBCLASS 	5
	saber		saber_reborn_mp
	saberColor	red
	weapon	WP_SABER
	MB_ATT_FORCEBLOCK 3
	MB_ATT_FP_SABER_DEFENSE 1
	MB_ATT_GUN_DEFENSE 1
	MB_ATT_DEFLECT 1
	RESOURCE_FORCE 1
	Pbchance 30
	MBchance 3
	SBchance 50
	saberStyle	2
	FP_LEVITATION	3
	FP_LIGHTNING	3
	RESOURCE_FORCE 1
	forcePowerMax	200
	forceRegenAmount	2
	rank		captain
	reactions	1
	aim			1
	move		1
	aggression	5
	evasion		3
	intelligence	1
	hfov		120
	vfov		120
	playerTeam	TEAM_PLAYER
	enemyTeam	TEAM_ENEMY
	class		CLASS_REBORN
	snd			cultist3
	sndcombat	cultist3
	sndjedi		cultist3
	yawSpeed	60
	walkSpeed	45
	runSpeed	180
	health		100
}

