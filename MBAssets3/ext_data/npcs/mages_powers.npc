//NNN: These are the mages aka force whores, they use the CLASS_MAGE so they spam force powers and keep close enough for powers but try to stay away from melee
//NNN: These are meant for testing, not use on maps!
mage_lightning
{
	playerModel	cultist
	customSkin	blue
	MBClass		5
	weapon		WP_MELEE
	MB_ATT_FORCEBLOCK 3
	FP_LEVITATION	3
	FP_LIGHTNING	3
	RESOURCE_FORCE 1
	forcePowerMax	200
	forceRegenAmount	2
	rank		captain
	reactions	1
	aim			1
	move		1
	aggression	5
	evasion		3
	intelligence	1
	hfov		120
	vfov		120
	playerTeam	TEAM_PLAYER
	enemyTeam	TEAM_ENEMY
	class		CLASS_MAGE
	snd			cultist3
	sndcombat	cultist3
	sndjedi		cultist3
	yawSpeed	60
	walkSpeed	45
	runSpeed	180
	health		100
}

