CT_Baton //leaving this here for now but the AI type doesn't feel right for Clones
{
	playerModel	clonetrooper_p2
	customSkin	cody_rgb
	weapon		WP_THERMAL
	weapon		WP_STUN_BATON
	MB_ATT_STUN_BATON 3
	reactions	3
	aim		1
	move		3
	aggression	3
	evasion		1
	intelligence	5
	rank		crewman
	health		50
	armor		15
	playerTeam	TEAM_PLAYER
	enemyTeam	TEAM_ENEMY
	class		CLASS_GRAN
	snd		clone_ep3
	sndcombat	clone_ep3
	sndextra	clone_ep3
	yawspeed	90
	walkSpeed	55
	runSpeed	187
	dismemberProbHead	0
	dismemberProbArms	10
	dismemberProbLegs	1
	dismemberProbHands	20
	dismemberProbWaist	0
}
