//NNN: These are the force adept gunners, they use the CLASS_ADEPT
//NNN: These are meant for testing, not use on maps!
adept_lightning
{
	playerModel	reborn_concept
	customSkin	force
	MBClass		5
	weapon		WP_BLASTER
	MB_ATT_FORCEBLOCK 3
	FP_LEVITATION	3
	FP_LIGHTNING	3
	RESOURCE_FORCE 1
	forcePowerMax	200
	forceRegenAmount	2
	rank		captain
	reactions	1
	aim			1
	move		1
	aggression	5
	evasion		3
	intelligence	1
	hfov		120
	vfov		120
	playerTeam	TEAM_PLAYER
	enemyTeam	TEAM_ENEMY
	class		CLASS_ADEPT
	snd			cultist3
	sndcombat	cultist3
	sndjedi		cultist3
	yawSpeed	100
	walkSpeed	45
	runSpeed	225
	health		100
}

