//Siege class def file.

ClassInfo
{
	name				"DOTFTF_Droideka_Heavy"
	weapons				WP_BLASTER_PISTOL
	attributes			MB_ATT_DEKA_SHIELD,3|MB_ATT_DEKA_HULL,1|MB_ATT_FIREPOWER,2|MB_ATT_SHIELD_PROJ,2|MB_ATT_DEKA_POWER,1
	model				"droideka"
	skin				"bronze"
	uishader			"models/players/droideka/mb2_icon_bronze"
	MBClass				MB_CLASS_DROIDEKA
	classNumberLimit	1
