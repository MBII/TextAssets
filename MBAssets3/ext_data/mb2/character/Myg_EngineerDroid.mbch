//Siege class def file.

ClassInfo
{
	name				"Myg_EngineerDroid"
	weapons				WP_MELEE|WP_BLASTER_PISTOL
	WP_MeleeFlags		HELD_SLOW
	attributes			MB_ATT_PISTOL,2|MB_ATT_AMMO,2|MB_ATT_HEALING,3|MB_ATT_DISP_HEALTH,3|MB_ATT_EWEB|MB_ATT_SENTRY|MB_ATT_DRONE|MB_ATT_RECHARGE,2|MB_ATT_CCTRAINING,1|MB_ATT_GETUPS,2
	//holdables			HI_EWEB|HI_SENTRY_GUN|HI_SEEKER
	maxhealth			80
	maxarmor			40
	basespeed			225
	model				"battledroid"
	skin				"engineer"
	uishader			"models/players/battledroid/mb2_icon_engineer"
	MBClass				MB_CLASS_BATTLEDROID
