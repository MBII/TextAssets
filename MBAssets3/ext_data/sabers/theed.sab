nute_cc2
{
	name		"E-5 Blaster Rifle"
	saberType	SABER_SINGLE
	saberModel	"models/weapons2/e5/e5_w.glm"
	soundOn	 "sound/weapons/detpack/select.mp3"
	soundLoop null
	soundOff	 "sound/weapons/detpack/select.mp3"
	saberLength	20
	saberRadius	4
 knockbackScale 1.5
	noCartwheels 1
	blasterblocking		0	
	throwable	0
	noWallMarks	1
	noDlight	1
	noBlade		1
	noClashFlare	1
	trailStyle	2
	noManualDeactivate	1
	damageScale 	1
	noIdleEffect		1
	onInWater		1
	bounceOnWalls		0
	disarmable 1
	useGoreConfig 	1
	useGoreConfig2 	1
	noDismemberment 1
	noDismemberment2 1
	noBladeEffects	1
	noBladeEffects2 1
	jumpAtkFwdMove LS_NONE
	jumpAtkLeftMove LS_NONE
	jumpAtkRightMove LS_NONE
 lungeAtkMove LS_NONE
	readyAnim BOTH_B5_T____ //overhead
 drawAnim BOTH_CONSOLE1START //BOTH_SPY_GRAB
 noRollStab 1
 noStabDown 1
 noKicks 1
 noBackAttack 1
 noRolls 1
 noFlips 1
	g2MarksShader "gfx/damage/bloodcutmark"
	g2WeaponMarkShader "gfx/effects/bloodsplat"
	spinsound	"s/w/t/swing3.wav"
	swingSound1	"s/w/h/swing1.mp3"
	swingSound2	"s/w/h/swing2.mp3"
	swingSound3	"s/w/h/swing3.mp3"
	spinSound	"s/w/p/swing1.mp3"
	swingSound1	"s/w/p/swing2.mp3"
	swingSound2	"s/w/p/swing3.mp3"
	swingSound3	"s/w/p/swing4.mp3"
	bounceSound1	"s/w/p/swing4.mp3"	
	bounceSound2	"s/w/p/swing2.mp3"
	bounceSound3	"s/w/p/swing1.mp3"
	hitSound1	"sound/weapons/blade/block_wood2.wav"
	hitSound2	"sound/weapons/blade/block_wood2.wav"
	hitSound3	"sound/weapons/blade/block_wood2.wav"
	blockSound1	"s/w/h/block1.mp3"
	blockSound2	"s/w/h/block2.mp3"
	blockSound3	"s/w/h/block3.mp3"
	blockEffect	"melee_weap/block"
	hitOtherEffect	"melee_weap/other"
}

