//----------------------------------------------------------------------------------------------
//	MENU BACKGROUND
//----------------------------------------------------------------------------------------------
		itemDef
		{
			name				bg_help
			group				none
			style				WINDOW_STYLE_SHADER
			rect				0 0 580 420
			background			"gfx/menus/alpha/Menu_Mission"
			forecolor			0 0 0 0.8
			visible				1
			decoration
		}						

		itemDef
		{
			name				btn_hl
			group				none
			style				WINDOW_STYLE_SHADER
			rect				0 0 0 0
			background			"gfx/menus/alpha/Btn_hl"
			forecolor			1 1 1 1
			visible				0
			decoration
		}		

		itemDef
		{
			name				button_glow
			group				none
			style				WINDOW_STYLE_SHADER
			rect				0 0 0 0
			background			"gfx/menus/alpha/Button_Highlight"
			forecolor			1 1 1 0.8
			visible				0
			decoration
		}			
		
// BACKGROUND

		itemDef
		{
			name panelCinematic
			style WINDOW_STYLE_CINEMATIC
			rect				0 0 0 0
			cinematic			"LibraryDuel_BackgroundVid.roq"
			forecolor			1 1 1 1
			visible				1
			border 1
			bordersize 0
			bordercolor 0.25 0.25 0.25 0
			decoration
		}

		itemDef
		{
			name btn_arrow_hl
			style WINDOW_STYLE_SHADER
			rect				35 10 22 24
			background "gfx/menus/alpha/Btn_Arrow_Hl"
			forecolor			1 1 1 0.65 
			visible				0
			decoration
		}

		itemDef
		{
			name btn_home_hl
			style WINDOW_STYLE_SHADER
			rect				10 10 22 24
			background "gfx/menus/alpha/Btn_Home_Hl"
			forecolor			1 1 1 0.65 
			visible				0
			decoration
		}

		itemDef
		{
			name btnHome
			type ITEM_TYPE_BUTTON
			style WINDOW_STYLE_SHADER
			rect				10 10 22 24
			background "gfx/menus/alpha/Btn_Home"
			forecolor			1 1 1 0.1
			visible				1
			onFocus
			{
				setcolor forecolor 1 1 1 0.25
				show btn_home_hl
			}
			leaveFocus
			{
				setcolor forecolor 1 1 1 0.1
				hide btn_home_hl
			}
			action{
				setcvar ui_library "main"
				setcvar ui_library_extragroup "   "
				uiscript2 helpmenuScripts "closeweaponsmenu"
				setitembordersize panelCinematic 0
			}
		}

		itemDef
		{
			name btnBack
			type ITEM_TYPE_BUTTON
			style WINDOW_STYLE_SHADER
			rect				35 10 22 24
			background "gfx/menus/alpha/Btn_Arrow"
			forecolor			1 1 1 0.1
			visible				1
			onFocus
			{
				setcolor forecolor 1 1 1 0.25
				show btn_arrow_hl
			}
			leaveFocus
			{
				setcolor forecolor 1 1 1 0.1
				hide btn_arrow_hl
			}
			action{
				setfocus btnback
				setcvar ui_library_model "   "
				setcvar ui_library_extragroup "   "
				uiscript libraryBtnBack
				setitemcinematic panelCinematic "q"
				setitembordersize panelCinematic 0
				setfocus btnBack
				show btn_arrow_hl
				uiscript2 helpmenuScripts "closeweaponsmenu"
			}
		}

		itemDef
		{
			name WIPLibrary
			group main
			style WINDOW_STYLE_SHADER
			type ITEM_TYPE_TEXT
			rect			156 43 150 25
			background "gfx/menus/blackMask"
			textscale 0.3
			text ""
			font 6
			textalign ITEM_ALIGN_MIDDLE
			textaligny -4
			forecolor			1 1 0 1//1 1 0 1
			border 1
			bordersize 1
			bordercolor 0.5 1 0 1
			visible				0
			onVisible
			{
				transition WIPLibrary 12 10 0 50 12 10 550 50 10 30
				setitemtext WIPLibrary "WORK IN PROGRESS"
			}
			visibleLoop
			{
				setcolor bordercolor 1 1 1 1
				delay 100;
				setcolor bordercolor 0.9 0.9 0.9 1
				delay 100;
				setcolor bordercolor 0.8 0.8 0.8 1
				delay 100;
				setcolor bordercolor 0.7 0.7 0.7 1
				delay 100;
				setcolor bordercolor 0.6 0.6 0.6 1
				delay 100;
				setcolor bordercolor 0.5 0.5 0.5 1
				delay 100;
				setcolor bordercolor 0.4 0.4 0.4 1
				delay 100;
				setcolor bordercolor 0.3 0.3 0.3 1
				delay 100;
				setcolor bordercolor 0.2 0.2 0.2 1
				delay 100;
				setcolor bordercolor 0.3 0.3 0.3 1
				delay 100;
				setcolor bordercolor 0.4 0.4 0.4 1
				delay 100;
				setcolor bordercolor 0.5 0.5 0.5 1
				delay 100;
				setcolor bordercolor 0.6 0.6 0.6 1
				delay 100;
				setcolor bordercolor 0.7 0.7 0.7 1
				delay 100;
				setcolor bordercolor 0.8 0.8 0.8 1
				delay 100;
				setcolor bordercolor 0.9 0.9 0.9 1
				delay 100;
			}
			decoration
		}

		itemDef
		{
			name btnWeaponsNext
			group main_weapons
			type ITEM_TYPE_BUTTON
			style WINDOW_STYLE_SHADER
			rect				535 10 22 24
			background2 "gfx/menus/alpha/Btn_Arrow"
			bg2Rect 535 10 -22 24
			forecolor			1 1 1 0.1
			visible				1
			onFocus
			{
				setcolor forecolor 1 1 1 0.25
				setitemrect btn_arrow_hl 535 10 -22 24
				show btn_arrow_hl
			}
			leaveFocus
			{
				setcolor forecolor 1 1 1 0.1
				setitemrect btn_arrow_hl 35 10 22 24
				hide btn_arrow_hl
			}
			action{
				hide btn_arrow_hl
				setcvar ui_library "main_weapons_2"
			}
		}














































		itemDef
		{
			name sabering
			group main
			type ITEM_TYPE_BUTTON
			style WINDOW_STYLE_SHADER
			rect				50 70 140 127
			background			"gfx/menus/sabering_picMask"
			border 1
			bordersize 2
			bordercolor 1 1 1 0.5
			forecolor			1 1 1 0.65 
			visible				1
			mouseEnter
			{
				setitemcinematic panelCinematic "LibraryDuel_BackgroundVid.roq"
				setitemrect panelCinematic 	53 72 137 127										// 0 0 109 127, so +3 +2 -3 +0
				setcolor bordercolor 1 0.5 0 1
				setitemcolor sabering_gfx forecolor 1 0.5 0 1
				setitembackground sabering "gfx/menus/blackMask"
			}
			mouseExit
			{
				setitembackground sabering	"gfx/menus/sabering_picMask"
				setitemcolor sabering_gfx forecolor 1 1 1 0.75;
