				setitemtext weaponrytextscroll @NEWHELP_CLASSES_SITH_WEAPONS
				setitemtext desctextscroll @NEWHELP_CLASSES_SITH_DESCRIPTION

				uiscript2 helpmenuScripts "4specials"
			}
		}



