//	MULTIPLAYER - Library Menu
{
	menuDef 
	{
		name					"newlibrary"
		fullScreen				0
		rect					30 30 580 420					// Size and position of the menu
		focusColor				1 1 1 0.6				// Focus color for text and items
		descX					320
		descY					399
		descScale				0.12
		descColor				1 1 1 1
		descAlignment			ITEM_ALIGN_CENTER
		visible					1
		onOpen 
		{
			hide main
			hide all
			show main
		//	exec				"vstr ui_help_class; vstr ui_help_weapon; vstr ui_help_force; vstr ui_help_gamemode; vstr ui_help_strategy; vstr ui_help_faq"
		}
		onESC 
		{ 
			play				"sound/interface/back.mp3" ;
			close				newlibrary;
			open				ingame
			open				main_nomusic
		}


		itemDef
		{
			name helpmenuScripts
			type ITEM_TYPE_BUTTON
			rect 0 0 0 0
			case "1special"
			{
				setitemrect special1 351 254 20 26

				setitemrect special1Keybind 348 295 26 10

				setitemrect special1Text 318 310 90 95
			}
			case "2specials"
			{
				setitemrect special1 265 254 20 26
				setitemrect special2 436 254 20 26

				setitemrect special1Keybind 262 295 26 10
				setitemrect special2Keybind 432 295 26 10

				setitemrect special1Text 230 310 90 95
				setitemrect special2Text 400 310 90 95
			}
			case "3specials"
			{
				setitemrect special1 220 254 20 26
				setitemrect special2 355 254 20 26
				setitemrect special3 487 254 20 26

				setitemrect special1Keybind 217 295 26 10
				setitemrect special2Keybind 352 295 26 10
				setitemrect special3Keybind 484 295 26 10

				setitemrect special1Text 188 310 90 95
				setitemrect special2Text 321 310 90 95
				setitemrect special3Text 452 310 90 95
			}
			case "4specials"
			{
				setitemrect special1 195 254 20 26
				setitemrect special2 304 254 20 26
				setitemrect special3 408 254 20 26
				setitemrect special4 512 254 20 26

				setitemrect special1Keybind 192 295 26 10
				setitemrect special2Keybind 301 295 26 10
				setitemrect special3Keybind 405 295 26 10
				setitemrect special4Keybind 509 295 26 10

				setitemrect special1Text 160 310 90 95
				setitemrect special2Text 269 310 90 95
				setitemrect special3Text 373 310 90 95
				setitemrect special4Text 477 310 90 95
			}
			case "redirection"
			{
				setcvar ui_library_extragroup "    ";
				setcvartocvar ui_libraryPrev ui_library;
			}
			case "closeweaponsmenu"
			{
				close mb_weapon_a280; 			close mb_weapon_amban; 			 close mb_weapon_arcpistols;
				close mb_weapon_bowcaster; 		close mb_weapon_clonepistol; 	 clonse mb_weapon_clonerifle;
				close mb_weapon_disruptor; 		close mb_weapon_dlt20a; 		 close mb_weapon_droidekablaster;
				close mb_weapon_e11; 			close mb_weapon_ee3; 			 close mb_weapon_empgrenade;
				close mb_weapon_fireggrenade; 	close mb_weapon_fraggrenade; 	 close mb_weapon_pistol;
				close mb_weapon_plx; 			close mb_weapon_proj; 			 close mb_weapon_sbdblaster;
				close mb_weapon_sonicgrenade; 	close mb_weapon_t21; 			 close mb_weapon_thermaldetonator;
				close mb_weapon_westarm5; 		close mb_weapon_westarm5launcher; close mb_weapon_westarm5scope;
				close mb_weapon_westarpistol
			}
		}


