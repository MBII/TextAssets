				setitemtext banner "CLASS: SITH"
				setitemtext class_hp @NEWHELP_CLASSES_SITH_HEALTH
				setitemtext class_armor @NEWHELP_CLASSES_SITH_ARMOR
				setitemtext class_resource @NEWHELP_CLASSES_SITH_RESOURCE

				setitemtext class_movespeed @NEWHELP_CLASSES_SITH_SPEED

				setitemtext special1 @NEWHELP_CLASSES_SITH_CS1TITLE
				setitemtext special1text @NEWHELP_CLASSES_SITH_CS1

				setitemtext special2 @NEWHELP_CLASSES_SITH_CS2TITLE
				setitemtext special2text @NEWHELP_CLASSES_SITH_CS2

				setitemtext special3 @NEWHELP_CLASSES_SITH_CS3TITLE
