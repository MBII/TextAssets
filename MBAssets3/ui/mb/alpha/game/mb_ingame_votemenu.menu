// SETUP MENU
{
	menuDef
	{
		name					"ingame_votemenu"
		fullScreen				0// MENU_TRUE
		rect					53 50 494 418
		visible					0
		focusColor				1 1 1 0.6
		disableColor			0.5 0.5 0.5 1
		appearanceIncrement		75
		descX					320
		descY					383
		descScale				0.15
		descColor				0.5 0.5 0.5 0.5
		descAlignment			ITEM_ALIGN_CENTER
		outOfBoundsClick
		onESC
		{
			play					"sound/interface/back.mp3"
			close					ingame_about
			open					ingame		
		}
		onOpen
		{
			uiScript drawrtvmenu
		}

// BACKGROUND 
		
		itemDef
		{
			name				bg_mission
			group				none
			style				WINDOW_STYLE_FILLED_RGB1
			rect				0 0 534 418
			background			"gfx/menus/alpha/Menu_Mission"
			forecolor			0 0 0 0.77
			visible				1
			decoration
		}
		
		itemDef
		{
			name				btn_hl
			group				none
			style				WINDOW_STYLE_SHADER
			rect				0 0 0 0
			background			"gfx/menus/alpha/Btn_hl"
			forecolor			1 1 1 1
			visible				0
			decoration
		}

		itemDef
		{
			name				button_glow
			group				none
			style				WINDOW_STYLE_SHADER
			rect				0 0 0 0
			background			"gfx/menus/alpha/Button_Highlight"
			forecolor			1 1 1 0.8
			visible				0
			decoration
		}
		
// OBJECTIVE MENU
		itemDef
		{
			name				menu_rtv
			group				none
			type ITEM_TYPE_BUTTON
			textstyle WINDOW_STYLE_TEXT_RGB2
			style				WINDOW_STYLE_FILLED
			text "^7ROCK THE VOTE"
			font 7
			textscale 0.18
			rect				15 22 120 30
			background			"gfx/menus/alpha/btn2_bg"
			backcolor 			1 1 1 0.05
			forecolor			1 1 1 1
			notextblink 1
			visible				1
			textalign ITEM_ALIGN_MIDDLE
			mouseenter{
				setcolor backcolor 1 1 1 0.2
			}
			mouseexit{
				setcolor backcolor 1 1 1 0.05
			}
			action{
				setcolor backcolor 1 1 1 0.5
				exec "rtv"
			}
		}

		itemDef
		{
			name				menu_mission
			group				none
			type ITEM_TYPE_BUTTON
			textstyle WINDOW_STYLE_TEXT_RGB2
			style				WINDOW_STYLE_FILLED
			text "^7NOMINATE MAP"
			font 7
			textscale 0.18
			rect				15 63 120 30
			background			"gfx/menus/alpha/btn2_bg"
			backcolor 			1 1 1 0.05
			forecolor			1 1 1 1
			visible				1
			notextblink 1
			textalign ITEM_ALIGN_MIDDLE
			mouseenter{
				setcolor backcolor 1 1 1 0.2
			}
			mouseexit{
				setcolor backcolor 1 1 1 0.05
			}
			action{
				setcolor backcolor 1 1 1 0.5
				uiscript rtvnominate
			}
		}


		itemDef
		{
			name				entermap
			type ITEM_TYPE_EDITFIELD
			textstyle				WINDOW_STYLE_TEXT_RGB2
			style WINDOW_STYLE_FILLED
			font 7
			maxChars 48
			text "Map: "
			cvar ui_nominatemap
			textscale 0.18
			rect				150 63 140 25
			backcolor 			1 1 1 0.05
			forecolor			1 1 1 1
			backcolor 0 0 0 1
			visible				1
			notextblink 1
			textaligny -3
			textalign ITEM_ALIGN_LEFT
		}

		itemDef
		{
			name				map1BgTest
