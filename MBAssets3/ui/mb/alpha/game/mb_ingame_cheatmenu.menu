// SETUP MENU
{
	menuDef
	{
		name					"ingame_cheatmenu"
		fullScreen				0// MENU_TRUE
		rect					93 50 454 418
		visible					0
		focusColor				1 1 1 0.6
		disableColor			0.5 0.5 0.5 1
		appearanceIncrement		75
		descX					320
		descY					383
		descScale				0.15
		descColor				0.5 0.5 0.5 0.5
		descAlignment			ITEM_ALIGN_CENTER
		outOfBoundsClick
		onESC
		{
			play					"sound/interface/back.mp3"
			close					ingame_cheatmenu
			open					ingame		
		}
		onOpen
		{
			uiscript refreshNPCs
		}

// BACKGROUND 
		
		itemDef
		{
			name				bg_mission
			group				none
			style				WINDOW_STYLE_FILLED_RGB1
			rect				0 0 454 418
			background			"gfx/menus/alpha/Menu_Mission"
			forecolor			0 0 0 0.77
			visible				1
			decoration
		}
		
		itemDef
		{
			name				btn_hl
			group				none
			style				WINDOW_STYLE_SHADER
			rect				0 0 0 0
			background			"gfx/menus/alpha/Btn_hl"
			forecolor			1 1 1 1
			visible				0
			decoration
		}

		itemDef
		{
			name				button_glow
			group				none
			style				WINDOW_STYLE_SHADER
			rect				0 0 0 0
			background			"gfx/menus/alpha/Button_Highlight"
			forecolor			1 1 1 0.8
			visible				0
			decoration
		}


		itemDef
		{
			name btnNpcFilter
			type ITEM_TYPE_MULTI
			style WINDOW_STYLE_TEXT_RGB2
			font 6
			textscale 0.15
			rect 30 15 78 18
			textalign ITEM_ALIGN_CENTER
			cvar "ui_npcfilter"
			cvarStrList
			{
				"All"				none
				"Saber"    			wp_saber
				"Blasters"			wp_blaster
				"Melee"				wp_melee
			}
			text "Weapon:"
			visible 1
			textaligny -4
			textalignx 22
			mouseEnter
			{
				show button_glow
				setitemrect button_glow 30 15 78 18
			}
			mouseExit
			{
				hide button_glow
			}
			action
			{
				uiScript refreshNPCs
				exec			"vstr ui_npcfilter";
			}
		}

		itemDef
		{
			name				npclist
			rect 8 35 132 340
			type				ITEM_TYPE_LISTBOX
			style				WINDOW_STYLE_LISTBOX_RGB1
			textstyle			WINDOW_STYLE_TEXT_RGB1
			elementwidth		120
			elementheight		16
			font				6
			textaligny			-4
			textscale			0.15
			forecolor			1 1 1 1
			backcolor			0 0 0 0
			outlinecolor		1 1 1 0.35
			elementtype			LISTBOX_TEXT
			feeder 				FEEDER_NPCS
			elementtype			LISTBOX_TEXT
			textalign			ITEM_ALIGN_LEFT
			visible				1
			columns				1 0 0 120
			action
			{
				play			"sound/interface/choose_hilt.wav"
			}
		}

		itemDef
		{
			name				modelviewer
			group				models
			type				ITEM_TYPE_MODEL
			rect				350 10 100 170
			model_g2anim		"BOTH_STAND4"
			model_angle			80
			//mins maxs format is apparently z x y (hmmm... y x z?)
			model_g2mins		5 5 -14
			model_g2maxs		5 -5 30
			model_fovx			40
			model_fovy			50
			cvar                "ui_char_model_angle"
			isCharacter			1
			visible				1
			decoration
		}

		itemDef
		{
			name			btn_spawnnpc
			type			ITEM_TYPE_BUTTON
			style			WINDOW_STYLE_FILLED
			textstyle		WINDOW_STYLE_TEXT_RGB2
			background		"gfx/menus/alpha/Btn2_Bg"
			rect			153 330 80 25
			textscale		0.15
			font			6
			textaligny -1.5
			textalign		ITEM_ALIGN_MIDDLE
			text "SPAWN NPC"
			backcolor			1 1 1 0.05
			forecolor			1 1 1 1
			visible 1
			mouseEnter
			{
				setcolor	backcolor	1 1 1 0.3
			}
			mouseExit
			{
				setcolor	backcolor	1 1 1 0.05
			}
			action
			{
				play			"sound/interface/button1.wav"
				uiScript		spawnNPC
			}
		}

